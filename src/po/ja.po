msgstr ""
"-S <session>\t\t最初のファイルを読み込んだ後、ファイル <session> を実行する"

msgid "-s <scriptin>\tRead Normal mode commands from file <scriptin>"
msgstr ""
"-s <scriptin>\tノーマルモードのコマンドを <scriptin> ファイルから読み込む"

msgid "-w <scriptout>\tAppend all typed commands to file <scriptout>"
msgstr ""
"-w <scriptout>\t入力したすべてのコマンドを <scriptout> ファイルに追記する"

msgid "-W <scriptout>\tWrite all typed commands to file <scriptout>"
msgstr ""
"-W <scriptout>\t入力したすべてのコマンドを <scriptout> ファイルに書き込む"

msgid "-x\t\t\tEdit encrypted files"
msgstr "-x\t\t\t暗号化されたファイルを編集する"

msgid "-display <display>\tConnect Vim to this particular X-server"
msgstr "-display <display>\tVim を指定した X サーバーに接続する"

msgid "-X\t\t\tDo not connect to X server"
msgstr "-X\t\t\tX サーバーに接続しない"

msgid "-Y\t\t\tDo not connect to Wayland compositor"
msgstr "-Y\t\t\tWayland コンポジターに接続しない"

msgid "--clientserver <socket|x11> Backend for clientserver communication"
msgstr "--clientserver <socket|x11> clientserver 通信のバックエンド"

msgid "--remote <files>\tEdit <files> in a Vim server if possible"
msgstr "--remote <files>\t可能なら Vim サーバーで <files> を編集する"

msgid "--remote-silent <files>  Same, don't complain if there is no server"
msgstr "--remote-silent <files>  同上。サーバーがなくてもエラーを表示しない"

msgid ""
"--remote-wait <files>  As --remote but wait for files to have been edited"
msgstr ""
"--remote-wait <files>  --remote と同じだが、ファイルの編集が終わるまで待つ"

msgid ""
"--remote-wait-silent <files>  Same, don't complain if there is no server"
msgstr ""
"--remote-wait-silent <files>  同上。サーバーがなくてもエラーを表示しない"

msgid ""
"--remote-tab[-wait][-silent] <files>  As --remote but use tab page per file"
msgstr ""
"--remote-tab[-wait][-silent] <files>  --remote と同じだが、ファイルごとにタブ"
"ページを使う"

msgid "--remote-send <keys>\tSend <keys> to a Vim server and exit"
msgstr "--remote-send <keys>\tVim サーバーに <keys> を送信して終了する"

msgid "--remote-expr <expr>\tEvaluate <expr> in a Vim server and print result"
msgstr "--remote-expr <expr>\tVim サーバーで <expr> を評価し、結果を表示する"

msgid "--serverlist\t\tList available Vim server names and exit"
msgstr "--serverlist\t\tVim サーバー名の一覧を表示して終了する"

msgid "--servername <name>\tSend to/become the Vim server <name>"
msgstr ""
"--servername <name>\tVim サーバー <name> に送信、または <name> という名前の"
"サーバーになる"

msgid "--startuptime <file>\tWrite startup timing messages to <file>"
msgstr "--startuptime <file>\t起動時間の計測結果を <file> に書き出す"

msgid "--log <file>\t\tStart logging to <file> early"
msgstr "--log <file>\t\t<file> へのログ出力を早い段階で開始する"

msgid "-i <viminfo>\t\tUse <viminfo> instead of .viminfo"
msgstr "-i <viminfo>\t\t.viminfo の代わりに <viminfo> を使う"

msgid "--clean\t\t'nocompatible', Vim defaults, no plugins, no viminfo"
msgstr "--clean\t\t'nocompatible'、Vim の既定値、プラグインなし、viminfo なし"

msgid "-h  or  --help\tPrint Help (this message) and exit"
msgstr "-h  or  --help\tヘルプ (このメッセージ) を表示して終了する"

msgid "--version\t\tPrint version information and exit"
msgstr "--version\t\tバージョン情報を表示して終了する"

